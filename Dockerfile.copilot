# Copilot FastAPI service — slim runtime image (Step 5)
# No sentence-transformers / torch — uses OpenAI embeddings at query time.
#
# Build:  docker build -f Dockerfile.copilot -t copilot-api:1.0 .
# Run:    docker run -p 8002:8002 --env-file .env.copilot -e EMBEDDING_BACKEND=openai copilot-api:1.0
#
# Prerequisite: ingest with matching embeddings (see Dockerfile.copilot-ingest)

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" appuser

WORKDIR /app

COPY requirements-copilot-api.txt .
RUN pip install --no-cache-dir -r requirements-copilot-api.txt

COPY copilot/ ./copilot/
COPY scripts/ingest_documents.py ./scripts/
COPY data/documents/ ./data/documents/

RUN chown -R appuser:appuser /app
USER appuser

ENV EMBEDDING_BACKEND=openai

EXPOSE 8002

CMD ["python3", "-m", "uvicorn", "copilot.api.main:app", "--host", "0.0.0.0", "--port", "8002"]
