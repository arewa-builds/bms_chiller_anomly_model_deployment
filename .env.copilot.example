# Chroma Cloud — copy to .env.copilot and fill in from dashboard
#
# Dashboard: https://www.trychroma.com/arewaiyi/aws-us-east-1/BMS
# Click "Connect" on your BMS database to get API key and tenant ID.
#
# Then run:
#   export $(grep -v '^#' .env.copilot | xargs)
#   python3 scripts/ingest_documents.py
#   python3 scripts/test_chroma_cloud.py

CHROMA_MODE=cloud
CHROMA_API_KEY=ck-your-api-key-here
CHROMA_TENANT=your-tenant-id-here
CHROMA_DATABASE=BMS
CHROMA_COLLECTION_NAME=chiller_troubleshooting

# Step 2 — OpenAI LLM (required for ask_copilot.py and diagnose route)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Embeddings — must match between ingest and retrieval
# local  → sentence-transformers (default for host dev; requires pip install -r requirements-copilot-ingest.txt)
# openai → text-embedding-3-small (default in Docker API; no torch in image)
EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
