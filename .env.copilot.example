# Chroma Cloud — copy to .env.copilot and fill in from dashboard
#
# Dashboard: https://www.trychroma.com/arewaiyi/aws-us-east-1/BMS
# Click "Connect" on your BMS database to get API key and tenant ID.
#
# Then run:
#   export $(grep -v '^#' .env.copilot | xargs)
#   python3 scripts/ingest_documents.py
#   python3 scripts/test_chroma_cloud.py

CHROMA_MODE=cloud
CHROMA_API_KEY=ck-your-api-key-here
CHROMA_TENANT=your-tenant-id-here
CHROMA_DATABASE=BMS
CHROMA_COLLECTION_NAME=chiller_troubleshooting
