# Copilot / ChromaDB — copy to .env.copilot and source before running scripts
#
# Mode 1: embedded (default) — database stored as files in ./chroma_db/
#   python3 scripts/ingest_documents.py
#   python3 scripts/inspect_chroma_db.py
#
# Mode 2: server — Chroma runs as a real database service (recommended to explore)
#   docker compose up chroma -d
#   export CHROMA_MODE=server
#   python3 scripts/ingest_documents.py
#   python3 scripts/inspect_chroma_db.py
#   Open http://localhost:8001/docs in your browser

CHROMA_MODE=server
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=chiller_troubleshooting
